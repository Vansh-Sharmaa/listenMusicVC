datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String
  avatarUrl String?
  createdAt DateTime @default(now())
  
  participants   CallParticipant[]
  messages       ChatMessage[]
  uploadedTracks MusicTrack[]
}

model Room {
  id        String   @id @default(uuid())
  name      String
  hostId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants CallParticipant[]
  messages     ChatMessage[]
  musicState   RoomMusicState?
}

model CallParticipant {
  id       String    @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  message   String
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MusicTrack {
  id            String   @id @default(uuid())
  title         String
  artist        String
  url           String   // URL to the music file (uploaded or royalty-free)
  duration      Float    // Duration in seconds
  isRoyaltyFree Boolean  @default(false)
  uploadedById  String?
  createdAt     DateTime @default(now())

  uploadedBy User?            @relation(fields: [uploadedById], references: [id])
  roomStates RoomMusicState[]
}

model RoomMusicState {
  id                    String   @id @default(uuid())
  roomId                String   @unique
  currentTrackId        String?
  isPlaying             Boolean  @default(false)
  lastPosition          Float    @default(0.0) // Position in seconds
  lastPositionUpdatedAt DateTime @default(now())
  updatedAt             DateTime @updatedAt

  room         Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  currentTrack MusicTrack? @relation(fields: [currentTrackId], references: [id])
}
